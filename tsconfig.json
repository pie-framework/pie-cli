{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",           // was es6
    "lib": ["es2020", "dom"],     // ensure modern lib types
    "skipLibCheck": true,         // avoid duplicate identifier noise
    "esModuleInterop": true,
    "strict": false,
    "noImplicitAny": false,
    "outDir": "lib/",
    "typeRoots": [
      "./node_modules/@types",
      "./local-typings"
    ]
  },
  "include": ["src/**/*"]
}
